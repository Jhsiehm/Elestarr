# Copy to .env.local and fill from the Supabase project settings.
# Then run supabase/schema.sql (new project) or supabase/patch-onboard-proofs.sql (existing).
# Auth: Authentication > Providers > Email > turn Confirm email OFF for this prototype.
#
# Browser (Vite): only VITE_ / NEXT_PUBLIC_ names are shipped to the client.
# Server (@supabase/server): unprefixed SUPABASE_* names. Never put the secret
# key on a VITE_ or NEXT_PUBLIC_ variable.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Inbound mailbox (Cloudflare Email Routing or Resend inbound):
# MX for elestarr.io → your provider
# Catch prove+*@elestarr.io and POST the raw RFC822 to:
#   https://<project>.supabase.co/functions/v1/inbound-mail
# Headers: apikey: <SUPABASE_SECRET_KEY>

